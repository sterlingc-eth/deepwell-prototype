# M3 Infrastructure Configuration
# Generated: September 13, 2026
# Services: Neon, Cloudflare R2, Clerk, Inngest, Sentry

# Database (Neon PostgreSQL)
NEON_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Object Storage (Cloudflare R2)
# R2_ACCOUNT_ID is the Cloudflare account id, not a token. It is part of the
# S3 endpoint host (<account-id>.r2.cloudflarestorage.com), so requests cannot
# be signed without it.
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-bucket-name>

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_<your-key>
CLERK_SECRET_KEY=sk_test_<your-secret-key>

# Background Jobs (Inngest)
# INNGEST_API_KEY was never a real variable name. The SDK reads these two:
#
#   INNGEST_EVENT_KEY    lets the app SEND events. Its presence is also the
#                        switch that turns queueing on: with it unset,
#                        /api/read-document runs inline exactly as before.
#   INNGEST_SIGNING_KEY  lets Inngest CALL BACK into /api/inngest, and is what
#                        proves the caller is Inngest. Without it that route is
#                        publicly reachable and will execute whatever is posted
#                        to it. Do not deploy the queue without this set.
INNGEST_EVENT_KEY=<your-inngest-event-key>
INNGEST_SIGNING_KEY=signkey-prod-<your-inngest-signing-key>
# Only needed if Vercel's host header is wrong (custom domain, proxy):
# INNGEST_SERVE_ORIGIN=https://deepwellinc.vercel.app

# Error Monitoring (Sentry)
SENTRY_DSN=https://<your-sentry-dsn>

# Anthropic (answers + document reading)
# The code reads CLAUDE_API_KEY first and falls back to ANTHROPIC_API_KEY.
CLAUDE_API_KEY=sk-ant-api03-<your-key>
ANTHROPIC_API_KEY=sk-ant-api03-<your-key>

# Model selection. Both are optional; the defaults are what ships.
#   TRANSCRIBE_MODEL  reads bytes (scans, photos, PDFs) into page text. This is
#                     real OCR and is the expensive call. Sonnet by default.
#   EXTRACT_MODEL     reads the page text back out into structured fields. The
#                     input is already text, so Haiku is the default. Measure
#                     with `npm run eval:retrieval` before paying for more.
# TRANSCRIBE_MODEL=claude-sonnet-4-5
# EXTRACT_MODEL=claude-haiku-4-5
