# M3 Infrastructure Configuration
# Generated: September 13, 2026
# Services: Neon, Cloudflare R2, Clerk, Inngest, Sentry

# Database (Neon PostgreSQL)
NEON_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Object Storage (Cloudflare R2)
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-bucket-name>

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_<your-key>
CLERK_SECRET_KEY=sk_test_<your-secret-key>

# Background Jobs (Inngest)
INNGEST_API_KEY=<your-inngest-key>

# Error Monitoring (Sentry)
SENTRY_DSN=https://<your-sentry-dsn>
